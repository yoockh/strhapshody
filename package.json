{
  "name": "strhapshody",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Air guitar app: webcam + hand tracking turns your hands into a playable guitar.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:engine": "wasm-pack build engine --target web --out-dir pkg",
    "roundtrip:engine": "npm run build:engine && node scripts/engine-roundtrip.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:engine": "cd engine && cargo test",
    "test:all": "npm run test:engine && npm run test",
    "test:e2e": "npm run build:engine && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35"
  }
}
